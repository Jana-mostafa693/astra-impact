# Read-only API and frontend: no database or secrets required.
# Vite: set in frontend/.env.local only if using a separately hosted API.
VITE_API_BASE_URL=/api
# Vite development server proxy target.
API_PROXY_TARGET=http://127.0.0.1:8000
# FastAPI CORS allowlist if not using same-origin proxy.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production launcher: set these in the shell or container environment.
PORT=3000
HOST=127.0.0.1
